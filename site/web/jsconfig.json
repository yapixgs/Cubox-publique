{
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["svelte", "node"]
  },
  "include": ["src/**/*", "tests/**/*", "*.js"]
}
