# Maintainer: Yapix
pkgname=cubox
# Version dynamique : dérivée du git (voir pkgver() plus bas).
# La valeur ci-dessous n'est qu'un placeholder, makepkg la remplace au build.
pkgver=1.2
pkgrel=1
# epoch=1 : la version est passée de « 3.15.* » à « 1.0.* ». Sans epoch, pacman
# verrait 1.0 < 3.15 et refuserait la mise à jour (downgrade). L'epoch prime sur
# le reste de la version et garantit que « 1:1.0.* » est bien vu comme plus récent.
epoch=1
pkgdesc="Cubox — launcher Minecraft hors-ligne, fork rebrandé de HMCL"
arch=('any')
url="https://forge.oxitablock.com/Yapix839/Cubox"
license=('GPL-3.0-or-later')
depends=('java-runtime>=11')
makedepends=('jdk21-openjdk' 'git')
source=("git+https://forge.oxitablock.com/Yapix839/Cubox.git#branch=main")
sha256sums=('SKIP')

# Génère une version unique par commit (ex. 1.0.r123.g9d723c5) afin que
# chaque nouveau commit sur main déclenche un vrai rebuild — sinon makepkg
# réinstalle l'ancien paquet déjà compilé au lieu de recompiler le code à jour.
pkgver() {
  cd "$srcdir/Cubox"
  printf "1.2.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/Cubox"
  chmod +x ./gradlew
  # Force JDK 21 (version testée) plutôt que le JDK système éventuellement trop récent
  export JAVA_HOME=/usr/lib/jvm/java-21-openjdk

  # Clé API CurseForge (active le navigateur CurseForge dans Cubox).
  # La clé N'EST PAS dans le dépôt : on la lit depuis la variable
  # d'environnement CURSEFORGE_API_KEY, ou depuis un fichier local
  # ~/.config/cubox/curseforge.key (une seule ligne = la clé).
  # Sans clé, Cubox fonctionne quand même (Modrinth uniquement).
  local cubox_cf_key_file="${XDG_CONFIG_HOME:-$HOME/.config}/cubox/curseforge.key"
  if [ -z "${CURSEFORGE_API_KEY:-}" ] && [ -r "$cubox_cf_key_file" ]; then
    CURSEFORGE_API_KEY="$(tr -d '[:space:]' < "$cubox_cf_key_file")"
  fi
  export CURSEFORGE_API_KEY="${CURSEFORGE_API_KEY:-}"

  # Build local : Gradle télécharge ses dépendances depuis Internet (machine Arch = OK)
  JAVA_TOOL_OPTIONS="-XX:-UsePerfData" VERSION_TYPE="unofficial" \
    "$JAVA_HOME/bin/java" -version
  # `clean` d'abord : garantit que le jar embarque bien la version courante
  # (hmcl.properties), même si un build/ d'une compilation précédente traîne.
  JAVA_TOOL_OPTIONS="-XX:-UsePerfData" VERSION_TYPE="unofficial" \
    ./gradlew clean :HMCL:makeExecutables --no-daemon --stacktrace
}

package() {
  cd "$srcdir/Cubox"
  local jar
  jar=$(ls HMCL/build/libs/Cubox-*.jar | head -n1)

  install -Dm644 "$jar" "$pkgdir/usr/share/java/cubox/Cubox.jar"
  install -Dm755 packaging/aur/cubox.sh       "$pkgdir/usr/bin/cubox"
  install -Dm644 packaging/aur/cubox.desktop  "$pkgdir/usr/share/applications/cubox.desktop"
  install -Dm644 HMCL/image/cubox.png          "$pkgdir/usr/share/pixmaps/cubox.png"
  install -Dm644 LICENSE                       "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
